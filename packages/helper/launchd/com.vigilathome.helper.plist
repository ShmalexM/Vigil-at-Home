<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for the Vigil helper. Installed to /Library/LaunchDaemons by the
  app (SMAppService.daemon in the signed build). The helper and its Node
  runtime live in /Library/PrivilegedHelperTools, owned by root, so nothing
  running as the user can replace what runs as root.

  The job starts Node and helper.mjs itself, through vigil-helper.d/current,
  not through the vigil-helper launcher: that is a /bin/sh script, and on
  2026-10-10 a block on /bin/sh's hash would have kept the helper from
  starting again. install.sh stops the job before it switches `current`, so
  launchd never starts it halfway through a switch. launchd starts a daemon
  with an empty environment; PATH below is the one the launcher sets.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vigilathome.helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/vigil-helper.d/current/node</string>
		<string>/Library/PrivilegedHelperTools/vigil-helper.d/current/helper.mjs</string>
		<string>daemon</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Vigil/helper.log</string>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
