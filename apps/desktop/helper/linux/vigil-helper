#!/bin/sh
# The Vigil helper: Node and the bundled helper, both root-owned. linux/install.sh
# keeps each version in vigil-helper.d/versions/<id> and points
# vigil-helper.d/current at one. Read the link once, so node and helper.mjs
# always come from the same version.
D=/usr/libexec/vigil-helper.d
V=$(readlink "$D/current") || { echo "The Vigil helper isn't installed: $D/current is missing." >&2; exit 1; }
case $V in
  versions/*/* | versions/.* | versions/) echo "Unexpected $D/current: $V" >&2; exit 1 ;;
  versions/*) ;;
  *) echo "Unexpected $D/current: $V" >&2; exit 1 ;;
esac
exec "$D/$V/node" "$D/$V/helper.mjs" "$@"
