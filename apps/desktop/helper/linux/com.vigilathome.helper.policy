<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets Vigil at Home ask for your password before the helper undoes a block.
     pkexec runs only `/usr/libexec/vigil-helper approve <nonce>…`, and only
     after an administrator's password, every time. -->
<policyconfig>
  <vendor>Vigil at Home</vendor>
  <action id="com.vigilathome.helper.approve">
    <description>Approve a Vigil at Home action</description>
    <message>Vigil at Home needs your password to approve this change.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vigil-helper</annotate>
  </action>
</policyconfig>
